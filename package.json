{
  "name": "samvidhan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Samvidhan: the Constitution of India, made readable. Zero cost static website.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data:sync && npm run vendor:ai && astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:extract": "node scripts/extract/run.ts",
    "data:sync": "node scripts/sync-collections.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "data:amendments": "node scripts/extract/amendments.ts",
    "data:embed": "node scripts/embed/run.ts",
    "vendor:ai": "./scripts/vendor-ai.sh",
    "model:fetch": "./scripts/fetch-model.sh",
    "audit:lighthouse": "./scripts/lighthouse-audit.sh"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@orama/orama": "^3.1.18",
    "astro": "^7.2.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.1.0",
    "lighthouse": "^13.4.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
