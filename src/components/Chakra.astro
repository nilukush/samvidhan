---
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;

/** 24 spokes at 15 degrees, hub to rim, rendered at build time. */
const spokes = Array.from({ length: 24 }, (_, i) => {
  const angle = (i * 15 * Math.PI) / 180;
  return {
    x1: 50 + 10 * Math.cos(angle),
    y1: 50 + 10 * Math.sin(angle),
    x2: 50 + 45 * Math.cos(angle),
    y2: 50 + 45 * Math.sin(angle),
  };
});
---

<svg viewBox="0 0 100 100" width={size} height={size} class={className} aria-hidden="true" focusable="false">
  <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="4"></circle>
  <circle cx="50" cy="50" r="7" fill="currentColor"></circle>
  {
    spokes.map((spoke) => (
      <line x1={spoke.x1} y1={spoke.y1} x2={spoke.x2} y2={spoke.y2} stroke="currentColor" stroke-width="3" />
    ))
  }
</svg>
