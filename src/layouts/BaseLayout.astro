---
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_TAGLINE } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Pagefind filter value used to group search results. */
  searchType?: string;
}

const { title = `${SITE_NAME}: ${SITE_TAGLINE}`, description = `${SITE_TAGLINE}`, searchType = 'Pages' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <span class="search-filter" data-pagefind-filter="type" aria-hidden="true">{searchType}</span>
      <slot />
    </main>
    <Footer />

    <div id="search-dialog" class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="search-title" hidden>
      <div class="search-panel">
        <div class="search-bar">
          <h2 id="search-title">Search the Constitution</h2>
          <button type="button" class="search-close" aria-label="Close search">Close</button>
        </div>
        <input
          id="search-input"
          type="search"
          placeholder="Articles, amendments, schedules, pages"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search query"
        />
        <div id="search-status" role="status" aria-live="polite"></div>
        <div id="search-results"></div>
      </div>
    </div>

    <script src="/search.js" defer></script>
  </body>
</html>

<style>
  .search-filter {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .search-dialog {
    position: fixed;
    inset: 0;
    background: rgba(6, 3, 141, 0.55);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
    z-index: 200;
    overflow-y: auto;
  }

  .search-dialog[hidden] {
    display: none;
  }

  .search-panel {
    background: var(--color-paper);
    border-radius: var(--radius-m);
    box-shadow: 0 12px 40px rgba(6, 3, 141, 0.18);
    width: min(44rem, 100%);
    padding: var(--space-6);
  }

  .search-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .search-bar h2 {
    font-size: var(--text-heading-m);
    color: var(--color-navy);
  }

  .search-close {
    font: inherit;
    font-weight: 700;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }

  #search-input {
    font: inherit;
    width: 100%;
    padding: var(--space-3);
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-s);
    background: var(--color-surface);
  }

  #search-status {
    font-size: var(--text-body-s);
    color: var(--color-ink);
    margin: var(--space-2) 0;
    min-height: 1.25em;
  }

  #search-results h3 {
    font-size: var(--text-body-s);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-navy);
    margin: var(--space-4) 0 var(--space-2);
  }

  #search-results ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #search-results li {
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-2) 0;
  }

  #search-results a {
    font-weight: 700;
    color: var(--color-link);
  }

  .search-excerpt {
    margin: var(--space-1) 0 0;
    font-size: var(--text-body-s);
  }

  .search-excerpt mark {
    background: var(--color-focus);
    padding: 0 2px;
  }

  .search-suggestion {
    font: inherit;
    font-size: var(--text-body-s);
    color: var(--color-link);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
</style>
