---
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Pagefind filter value used to group search results. */
  searchType?: string;
}

const props = Astro.props;
const rawTitle = props.title ?? `${SITE_NAME}: ${SITE_TAGLINE}`;
const rawDescription = props.description ?? SITE_TAGLINE;
const searchType = props.searchType ?? 'Pages';
// Title budget: 60 characters. Long titles are truncated but the site name
// suffix is preserved by clamping only the content portion.
const SUFFIX = ` | ${SITE_NAME}`;
let title: string;
if (rawTitle.length <= 60) {
  title = rawTitle;
} else if (rawTitle.endsWith(SUFFIX)) {
  const content = rawTitle.slice(0, -SUFFIX.length);
  title = content.slice(0, 60 - SUFFIX.length - 1).trimEnd() + '…' + SUFFIX;
} else {
  title = rawTitle.slice(0, 57).trimEnd() + '…';
}
const description = rawDescription.length > 155 ? rawDescription.slice(0, 155) : rawDescription;
// Canonical URL: trailing slash form, which is how the host serves every page.
const path = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const canonical = SITE_URL + (path === '' ? '/' : `/${path}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <span class="search-filter" data-pagefind-filter="type" aria-hidden="true">{searchType}</span>
      <slot />
    </main>
    <Footer />

    <div id="search-dialog" class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="search-title" hidden>
      <div class="search-panel">
        <div class="search-bar">
          <h2 id="search-title">Search the Constitution</h2>
          <button type="button" class="search-close" aria-label="Close search">Close</button>
        </div>
        <div class="search-tabs" role="tablist" aria-label="Search mode">
          <button type="button" id="tab-keywords" role="tab" aria-selected="true" aria-controls="panel-keywords"
            >Keywords</button
          >
          <button type="button" id="tab-concept" role="tab" aria-selected="false" aria-controls="panel-concept"
            >Concept</button
          >
        </div>
        <input
          id="search-input"
          type="search"
          placeholder="Articles, amendments, schedules, pages"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search query"
        />
        <div id="search-status" role="status" aria-live="polite"></div>
        <div id="panel-keywords" role="tabpanel" aria-labelledby="tab-keywords">
          <div id="search-results"></div>
        </div>
        <div id="panel-concept" role="tabpanel" aria-labelledby="tab-concept" hidden>
          <p class="concept-note">Finds meaning, not just words. The first search downloads a language model.</p>
          <div id="concept-status" role="status" aria-live="polite"></div>
          <div id="concept-results"></div>
        </div>
      </div>
    </div>

    <script src="/search.js" defer></script>
  </body>
</html>

<style>
  .search-filter {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .search-dialog {
    position: fixed;
    inset: 0;
    background: rgba(6, 3, 141, 0.55);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
    z-index: 200;
    overflow-y: auto;
  }

  .search-dialog[hidden] {
    display: none;
  }

  .search-panel {
    background: var(--color-paper);
    border-radius: var(--radius-m);
    box-shadow: 0 12px 40px rgba(6, 3, 141, 0.18);
    width: min(44rem, 100%);
    padding: var(--space-6);
  }

  .search-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .search-bar h2 {
    font-size: var(--text-heading-m);
    color: var(--color-navy);
  }

  .search-close {
    font: inherit;
    font-weight: 700;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }

  .search-tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .search-tabs button {
    font: inherit;
    font-weight: 700;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    cursor: pointer;
  }

  .search-tabs button[aria-selected='true'] {
    background: var(--color-navy);
    color: var(--color-paper);
    border-color: var(--color-navy);
  }

  .concept-note {
    font-size: var(--text-body-s);
    color: var(--color-ink);
    margin: var(--space-2) 0;
  }

  #concept-status {
    font-size: var(--text-body-s);
    min-height: 1.25em;
    margin: var(--space-2) 0;
  }

  #concept-results ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #concept-results li {
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-2) 0;
  }

  #concept-results a {
    font-weight: 700;
    color: var(--color-link);
  }

  #search-input {
    font: inherit;
    width: 100%;
    padding: var(--space-3);
    border: 2px solid var(--color-navy);
    border-radius: var(--radius-s);
    background: var(--color-surface);
  }

  #search-status {
    font-size: var(--text-body-s);
    color: var(--color-ink);
    margin: var(--space-2) 0;
    min-height: 1.25em;
  }

  #search-results h3 {
    font-size: var(--text-body-s);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-navy);
    margin: var(--space-4) 0 var(--space-2);
  }

  #search-results ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #search-results li {
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-2) 0;
  }

  #search-results a {
    font-weight: 700;
    color: var(--color-link);
  }

  .search-excerpt {
    margin: var(--space-1) 0 0;
    font-size: var(--text-body-s);
  }

  .search-excerpt mark {
    background: var(--color-focus);
    padding: 0 2px;
  }

  .search-suggestion {
    font: inherit;
    font-size: var(--text-body-s);
    color: var(--color-link);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
</style>
