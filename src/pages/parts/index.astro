---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { toRomanPart } from '../../lib/display';
import { SITE_NAME } from '../../config';

const parts = (await getCollection('parts')).sort(
  (a, b) => Number.parseInt(a.id, 10) - Number.parseInt(b.id, 10) || a.id.localeCompare(b.id),
);
const articles = await getCollection('articles');
const countFor = (part: string) => articles.filter((entry) => entry.data.part === part).length;
---

<BaseLayout
  title={`Parts of the Constitution of India | ${SITE_NAME}`}
  description="All parts of the Constitution of India, from the Union and its Territory to Short Title, with their articles."
>
  <div class="container page">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Parts' }]} />
    <h1>Parts of the Constitution</h1>
    <p class="lede">
      The Constitution is organised into {parts.length} parts, from the Union and its territory to trade, emergency provisions,
      and amendment.
    </p>
    <ul class="part-grid">
      {
        parts.map((part) => (
          <li>
            <a class="part-card" href={`/parts/${part.id}/`}>
              <span class="part-number">Part {toRomanPart(part.id)}</span>
              <span class="part-name">{part.data.name}</span>
              <span class="part-count">{countFor(part.id)} articles</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }

  h1 {
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }

  .lede {
    font-size: var(--text-body-l);
    max-width: 40rem;
    margin-bottom: var(--space-8);
  }

  .part-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .part-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-ink);
    height: 100%;
  }

  .part-card:hover {
    border-color: var(--color-navy);
  }

  .part-number {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-navy);
  }

  .part-name {
    font-weight: 700;
  }

  .part-count {
    font-size: var(--text-body-s);
    opacity: 0.75;
  }
</style>
