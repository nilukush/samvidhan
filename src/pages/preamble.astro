---
import { readFileSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { cleanLegalText } from '../lib/display';
import { SITE_NAME } from '../config';

const { preamble } = JSON.parse(readFileSync('data/processed/constitution.json', 'utf8')) as { preamble: string };
const text = cleanLegalText(preamble);
---

<BaseLayout
  searchType="Pages"
  title={`The Preamble to the Constitution of India | ${SITE_NAME}`}
  description="The Preamble to the Constitution of India: the people of India adopt, enact, and give to themselves the Constitution."
>
  <div class="container page">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Preamble' }]} />
    <p class="kicker">The Constitution of India</p>
    <h1>Preamble</h1>
    <p class="adopted">
      Adopted by the Constituent Assembly on 26 November 1949; the words Socialist, Secular, and Integrity were inserted
      by the Constitution (Forty-second Amendment) Act, 1976.
    </p>
    <blockquote class="preamble-text">{text}</blockquote>
    <p class="source">Text of the official edition, as on 1 May 2026.</p>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-12) var(--space-4) var(--space-16);
    max-width: 46rem;
  }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-body-s);
    color: var(--color-navy);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  h1 {
    font-size: var(--text-display-l);
    color: var(--color-navy);
    margin-bottom: var(--space-4);
  }

  .adopted {
    font-size: var(--text-body-s);
    color: var(--color-ink);
    border-left: 3px solid var(--color-saffron);
    padding-left: var(--space-3);
  }

  .preamble-text {
    font-family: var(--font-display);
    font-size: var(--text-body-l);
    line-height: 1.9;
    margin: var(--space-8) 0;
    padding: 0;
  }

  .source {
    font-size: var(--text-body-s);
    color: var(--color-ink);
  }
</style>
