---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getBills, latestVerifiedDate } from '../../lib/bills';
import { SITE_NAME } from '../../config';

const bills = getBills();
const latest = latestVerifiedDate(bills);
const [year, month, day] = latest.split('-');
const monthNames = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];
const displayDate = `${day} ${monthNames[Number(month) - 1]} ${year}`;

const HOUSE_LABELS: Record<string, string> = {
  'lok-sabha': 'Lok Sabha',
  'rajya-sabha': 'Rajya Sabha',
  both: 'Both houses',
};

const STATUS_LABELS: Record<string, string> = {
  pending: 'Pending',
  'passed-one-house': 'Passed one house',
  rejected: 'Rejected',
  lapsed: 'Lapsed',
};
---

<BaseLayout
  searchType="Pages"
  title={`Upcoming Changes | ${SITE_NAME}`}
  description={`Constitution amendment bills before Parliament, with status and sources, last verified ${displayDate}.`}
>
  <div class="container page">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Changes' }]} />
    <h1>Upcoming and recent changes</h1>
    <p class="lede">
      Constitution amendment bills that could change the text you read on this site: what each seeks to do, where it
      stands, and where the facts come from.
    </p>

    <div role="note" class="verified-banner">
      <p>
        Facts last verified {displayDate}. This page is updated by hand, about once a month; it is not a live feed. For
        live status see <a href="https://sansad.in/ls/legislation/bills" rel="noopener">sansad.in</a> and
        <a href="https://prsindia.org/billtrack" rel="noopener">PRS India</a>.
      </p>
    </div>

    <table class="bills-table">
      <caption class="visually-hidden">Constitution amendment bills with status, last verified date, and source</caption
      >
      <thead>
        <tr>
          <th scope="col">Bill</th>
          <th scope="col">House</th>
          <th scope="col">Status</th>
          <th scope="col">Last verified</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {
          bills.map((bill) => (
            <tr>
              <th scope="row">
                <span class="bill-title">{bill.title}</span>
                {bill.summary && <p class="bill-summary">{bill.summary}</p>}
                {bill.introducedOn && <p class="bill-introduced">Introduced {bill.introducedOn}</p>}
              </th>
              <td>{HOUSE_LABELS[bill.house] ?? bill.house}</td>
              <td>
                <span class={`pill pill-${bill.status}`}>{STATUS_LABELS[bill.status] ?? bill.status}</span>
              </td>
              <td>
                <time>{bill.lastVerified}</time>
              </td>
              <td>
                <a href={bill.sourceUrl} rel="noopener">
                  Source<span class="visually-hidden"> for {bill.title}</span>
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="method-note">
      Summaries are written for this site from the linked sources; no analysis text is copied. Constitution amendment
      bills need a special majority: two thirds of members present and voting in each house, plus ratification by half
      the state legislatures for certain provisions.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-12) var(--space-4) var(--space-16);
    max-width: 64rem;
  }

  h1 {
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }

  .lede {
    font-size: var(--text-body-l);
    margin-bottom: var(--space-6);
    max-width: 44rem;
  }

  .verified-banner {
    background: var(--color-amber-soft);
    border-left: 3px solid var(--color-amber);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-8);
  }

  .verified-banner p {
    margin: 0;
    color: var(--color-amber);
    font-size: var(--text-body-s);
  }

  .bills-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-body-s);
  }

  .bills-table th,
  .bills-table td {
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-3) var(--space-2) var(--space-3) 0;
    text-align: left;
    vertical-align: top;
  }

  .bills-table thead th {
    font-size: var(--text-body-s);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-navy);
  }

  .bill-title {
    font-weight: 700;
  }

  .bill-summary {
    margin: var(--space-2) 0 0;
    max-width: 34rem;
    font-weight: 400;
  }

  .bill-introduced {
    margin: var(--space-1) 0 0;
    font-weight: 400;
    opacity: 0.75;
  }

  .pill {
    display: inline-block;
    padding: 2px var(--space-2);
    border-radius: var(--radius-s);
    font-weight: 700;
    white-space: nowrap;
  }

  .pill-pending {
    background: var(--color-amber-soft);
    color: var(--color-amber);
  }

  .pill-passed-one-house {
    background: var(--color-green-soft);
    color: var(--color-green);
  }

  .pill-rejected,
  .pill-lapsed {
    background: var(--color-red-soft);
    color: var(--color-red);
  }

  .method-note {
    margin-top: var(--space-8);
    font-size: var(--text-body-s);
    max-width: 44rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
