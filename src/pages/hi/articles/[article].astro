---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { cleanLegalText, compareByDocumentOrder } from '../../../lib/display';
import { SITE_NAME, SITE_URL } from '../../../config';

export async function getStaticPaths() {
  const articles = (await getCollection('articlesHi')).sort(compareByDocumentOrder);
  return articles.map((entry, index) => ({
    params: { article: entry.id },
    props: {
      entry,
      prev: articles[index - 1] ?? null,
      next: articles[index + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const article = entry.data;
const parts = await getCollection('partsHi');
const part = parts.find((candidate) => candidate.id === article.part);
const partName = part?.data.name ?? '';
const siblings = (await getCollection('articlesHi', (candidate) => candidate.data.part === article.part)).sort(
  compareByDocumentOrder,
);

const clauseRows = article.clauses.map((clause) => ({
  kind: clause.kind,
  number: clause.number ? `(${clause.number}) ` : '',
  label: clause.kind === 'explanation' ? 'व्याख्या।' : clause.kind === 'illustration' ? 'उदाहरण।' : '',
  text: cleanLegalText(clause.text),
}));

const description = `अनुच्छेद ${article.numberHi} (${partName}): ${article.title}`.slice(0, 155);

const legislationLd = {
  name: `अनुच्छेद ${article.numberHi}. ${article.title.replace(/\.$/, '')}`,
  '@id': `${SITE_URL}/hi/articles/${entry.id.toLowerCase()}/`,
  url: `${SITE_URL}/hi/articles/${entry.id.toLowerCase()}/`,
  legislationType: 'ConstitutionalLaw',
  isPartOf: { '@type': 'Legislation', name: 'Constitution of India', '@id': `${SITE_URL}/` },
  datePublished: '1950-01-26',
  inLanguage: 'hi',
  keywords: `भारत का संविधान, अनुच्छेद ${article.numberHi}, ${partName}`,
};
const alternates = [
  { lang: 'en', href: `${SITE_URL}/articles/${entry.id.toLowerCase()}/` },
  { lang: 'x-default', href: `${SITE_URL}/articles/${entry.id.toLowerCase()}/` },
];
---

<BaseLayout
  searchType="Articles"
  lang="hi"
  title={`अनुच्छेद ${article.numberHi} | ${SITE_NAME}`}
  description={description}
  alternates={alternates}
>
  <JsonLd type="Legislation" data={legislationLd} />
  <div class="container page">
    <Breadcrumb
      items={[
        { label: 'होम', href: '/hi/' },
        { label: 'अनुच्छेद', href: '/hi/articles/' },
        { label: `भाग ${part?.data.numberHi ?? article.part}`, href: `/hi/parts/${article.part}/` },
        { label: `अनुच्छेद ${article.numberHi}` },
      ]}
    />

    <div class="article-layout">
      <article>
        <p class="kicker">भाग {part?.data.numberHi ?? article.part} &middot; {partName}</p>
        <h1><span class="article-number">अनुच्छेद {article.numberHi}</span> {article.title}</h1>

        {
          article.status === 'omitted' && (
            <p class="omitted-note">यह अनुच्छेद अब संविधान का भाग नहीं है। यह ऐतिहासिक अभिलेख के लिए यहाँ है।</p>
          )
        }

        <ol class="clauses">
          {
            clauseRows.map((row) => (
              <li class={row.kind === 'explanation' || row.kind === 'illustration' ? 'note' : undefined}>
                {row.label && <em class="note-label">{row.label}</em>}
                {row.number && <span class="clause-number">{row.number}</span>}
                {row.text}
              </li>
            ))
          }
        </ol>

        <p class="cross-lang">
          <a lang="en" href={`/articles/${entry.id.toLowerCase()}/`}>Article {article.number} in English</a>
        </p>

        <nav class="pager" aria-label="अनुच्छेद नेविगेशन">
          {
            prev ? (
              <a class="pager-prev" href={`/hi/articles/${prev.id}/`}>
                <span class="pager-direction">पिछला अनुच्छेद</span>
                <span class="pager-title">
                  {prev.data.numberHi}. {prev.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a class="pager-next" href={`/hi/articles/${next.id}/`}>
                <span class="pager-direction">अगला अनुच्छेद</span>
                <span class="pager-title">
                  {next.data.numberHi}. {next.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </article>

      <aside class="part-nav" aria-label={`भाग ${part?.data.numberHi ?? article.part} के अनुच्छेद`}>
        <h2>भाग {part?.data.numberHi ?? article.part}</h2>
        <ul>
          {
            siblings.map((sibling) => (
              <li>
                <a
                  href={`/hi/articles/${sibling.id}/`}
                  aria-current={sibling.id === entry.id ? 'page' : undefined}
                  class={sibling.id === entry.id ? 'current' : undefined}
                >
                  {sibling.data.numberHi}. {sibling.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-body-s);
    color: var(--color-navy);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .article-layout {
      grid-template-columns: minmax(0, 8fr) minmax(14rem, 4fr);
    }
  }

  h1 {
    color: var(--color-navy);
    font-size: var(--text-display-l);
    margin-bottom: var(--space-4);
  }

  .article-number {
    display: block;
    font-size: 0.55em;
    margin-bottom: var(--space-2);
  }

  .clauses {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-body-l);
    max-width: 42rem;
  }

  .clauses li {
    margin-bottom: var(--space-4);
    line-height: 1.85;
  }

  .clauses .note {
    border-left: 3px solid var(--color-line);
    padding-left: var(--space-3);
  }

  .note-label {
    font-style: italic;
    display: inline;
  }

  .clause-number {
    font-family: var(--font-mono);
    font-size: var(--text-mono-ref);
    color: var(--color-navy);
  }

  .omitted-note {
    border-left: 3px solid var(--color-red);
    padding-left: var(--space-3);
    font-size: var(--text-body-s);
  }

  .cross-lang {
    margin-top: var(--space-8);
    font-size: var(--text-body-s);
  }

  .cross-lang a {
    color: var(--color-link);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-12);
    max-width: 42rem;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-m);
    padding: var(--space-3);
    background: var(--color-surface);
  }

  .pager a:hover {
    border-color: var(--color-navy);
  }

  .pager-next {
    margin-left: auto;
    text-align: right;
  }

  .pager-direction {
    font-size: var(--text-body-s);
    color: var(--color-navy);
    font-weight: 700;
  }

  .pager-title {
    font-size: var(--text-body-s);
  }

  .part-nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .part-nav {
      display: block;
      position: sticky;
      top: var(--space-4);
      align-self: start;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
      border-left: 1px solid var(--color-line);
      padding-left: var(--space-4);
      font-size: var(--text-body-s);
    }

    .part-nav h2 {
      font-size: var(--text-heading-m);
      color: var(--color-navy);
      margin-bottom: var(--space-3);
    }

    .part-nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .part-nav li {
      margin-bottom: var(--space-1);
    }

    .part-nav a {
      display: block;
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-s);
      color: var(--color-ink);
      text-decoration: none;
    }

    .part-nav a:hover {
      background: var(--color-saffron-soft);
    }

    .part-nav a.current {
      background: var(--color-navy);
      color: var(--color-paper);
    }
  }
</style>
